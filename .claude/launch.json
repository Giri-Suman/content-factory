{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mission-control",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "apps/mission-control"
      ],
      "port": 4600
    },
    {
      "name": "mission-control-open",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:open",
        "--prefix",
        "apps/mission-control"
      ],
      "port": 4600
    }
  ]
}
