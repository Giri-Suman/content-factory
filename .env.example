# ── Copy this file to .env and fill in as each phase comes online. ──
# .env is gitignored. Never commit real keys.

# P1 · Voice (ElevenLabs — clone YOUR OWN voice, then paste its voice id)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── P2 · AI provider — pick ONE (or set several; priority: anthropic > openrouter > ollama).
# Force a specific one with LLM_PROVIDER=anthropic|openrouter|ollama
# LLM_PROVIDER=

# Option A · Anthropic (best writing quality) — console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_SCORING_MODEL=claude-haiku-4-5
# ANTHROPIC_SCRIPT_MODEL=claude-opus-4-8

# Option B · OpenRouter (one key, hundreds of models, cheap + FREE options) — openrouter.ai
# Free models end in ":free" (see openrouter.ai/models?q=free). "openrouter/auto" picks for you.
OPENROUTER_API_KEY=
# OPENROUTER_SCRIPT_MODEL=openrouter/auto
# OPENROUTER_SCORING_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Option C · Ollama (100% free, runs on YOUR machine, no key) — ollama.com
# Install ollama, then: ollama pull llama3.2   (bigger models write better)
# OLLAMA_MODEL=llama3.2
# OLLAMA_URL=http://localhost:11434

# P2 · Trend alerts via Telegram (optional but recommended)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# P5 · YouTube publishing (Google Cloud OAuth client, YouTube Data API v3)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Thumbnails via fal.ai Flux (optional)
FAL_KEY=

# Reddit: free "script" app at reddit.com/prefs/apps -> 100 queries/min.
# Without these, keyless Reddit collects only a rotating 3 subs per run.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Portal password. Set this BEFORE exposing the portal to the internet —
# it executes commands on the host. Unset = open (correct for localhost only).
FACTORY_PASSWORD=
