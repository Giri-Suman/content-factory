# dependencies
node_modules/
.next/
.venv/

# secrets — never commit
.env
.env.*
!.env.example

# generated output
# Repo-root render output only. This MUST stay anchored with a leading
# slash: a bare "renders/" also matches app/renders/ and app/api/renders/,
# which silently kept the Renders page out of every CI build while it kept
# working locally.
/renders/
data/*
!data/dictionary.example.json
dist/
out/
renderers/code-report/public/audio/
renderers/code-report/public/shots/
renderers/code-report/public/gen/

# python / manim
__pycache__/
media/
*.pyc

# os noise
.DS_Store
Thumbs.db

# Next/Vercel build output for the Pages build (generated, never committed)
.vercel/
.next/
